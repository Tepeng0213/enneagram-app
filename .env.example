# 复制为 .env 并填写（不要提交 .env 到 Git）

# Google Apps Script 网页应用 URL（部署 WebAppSubmit 后获得）
VITE_SHEET_WEBAPP_URL=https://script.google.com/macros/s/你的部署ID/exec

# 与 Apps Script「脚本属性」里 API_SECRET 相同
VITE_SHEET_API_SECRET=你的密钥

# 报告测试用汇总表行号（默认 2，始终出现在报告列表）
VITE_REPORT_TEST_ROW=2

# 可选：资料库检索代理（Cloud Run 等），POST { query } 返回 { text } 或 { summary }
# 未配置时使用审定静态三中心文案
# VITE_VERTEX_SEARCH_PROXY_URL=https://your-service/run/search
